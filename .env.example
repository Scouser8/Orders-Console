# Supply these values in your shell; this file is not loaded automatically.
# SQLite paths are relative to apps/api when using the workspace commands.
DATABASE_URL="file:./prisma/dev.db"
PORT=3000
# Required for the API. Generate a random secret locally; never commit its value.
JWT_SECRET=""
# Optional Vite proxy override when the API uses a different address or port.
API_PROXY_TARGET="http://127.0.0.1:3000"
